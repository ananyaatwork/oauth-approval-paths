# --- Live research (all free tiers) ---
# Search: Tavily is tried first, Serper is the backup. At least one is required.
TAVILY_API_KEY=
SERPER_API_KEY=
# Page reading is free and needs no key; a Jina key only raises the fallback reader's rate limit.
# JINA_API_KEY=

# Writer: Gemini models are tried in order. ANTHROPIC_API_KEY adds Claude as a last fallback.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Limits that protect your free quota ---
# New research runs per browser (cookie + browser fingerprint); 0 = unlimited. Saved guides never count.
# LIVE_RUNS_PER_VISITOR=1
# New research runs per UTC day across everyone; 0 = unlimited.
# LIVE_RUNS_PER_DAY=15
# Salt for hashing visitor identifiers; set any random string in production.
# VISITOR_SALT=

# --- Storage ---
# Durable store for saved guides and run counts (Vercel KV / Upstash Redis).
# Without these, a local .data/ folder is used.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
