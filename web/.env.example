# --- Live research (all free tiers) ---
# Search: Tavily is tried first, Serper is the backup. At least one is required.
TAVILY_API_KEY=
SERPER_API_KEY=
# Page reading is free and needs no key; a Jina key only raises the fallback reader's rate limit.
# JINA_API_KEY=

# Writer: Gemini models are tried in order. ANTHROPIC_API_KEY adds Claude as a last fallback.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# Free backup writer (build.nvidia.com, no card). Tried after the main Gemini models, before the lightest one.
# NVIDIA_API_KEY=
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,z-ai/glm-5.3
# Free headline checker (console.groq.com, no card). Its 8,000 tokens a minute is too small to write a guide.
# GROQ_API_KEY=
# GROQ_MODELS=qwen/qwen3.8-27b
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Limits that protect your free quota ---
# New research runs per browser (cookie + browser fingerprint); 0 = unlimited. Saved guides never count.
# LIVE_RUNS_PER_VISITOR=3
# New research runs per UTC day across everyone; 0 = unlimited.
# LIVE_RUNS_PER_DAY=50
# Secret for reviewer links: open /generate?reviewer=<this value> to run unfamiliar apps past the limits above.
# REVIEWER_KEY=
# Runs per UTC day through the reviewer link (its own cap, so a leaked link can't drain quota); 0 = unlimited.
# REVIEWER_RUNS_PER_DAY=10
# Age in days after which a saved live guide can be researched again.
# REFRESH_AFTER_DAYS=30
# Salt for hashing visitor identifiers; set any random string in production.
# VISITOR_SALT=

# --- Storage ---
# Durable store for saved guides and run counts (Vercel KV / Upstash Redis).
# Without these, a local .data/ folder is used.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
