ANTHROPIC_API_KEY=
# LIVE_MODEL=claude-sonnet-5-5
# Live research runs per visitor; 0 = unlimited. Saved guides never count.
# LIVE_RUNS_PER_VISITOR=1
# Salt for hashing visitor IPs; set any random string in production.
# VISITOR_SALT=
# Durable store for saved guides and run counts (Vercel KV / Upstash Redis).
# Without these, a local .data/ folder is used.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
